{
  "name": "club-content-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @club/app-api run dev",
    "dev:admin": "npm --workspace @club/admin-web run dev",
    "dev:worker": "npm --workspace @club/worker run dev",
    "dev:mobile": "npm --workspace @club/mobile run dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:vps": "bash scripts/dev_vps.sh",
    "demo:pilot": "bash scripts/pilot_demo.sh",
    "demo:operator": "bash scripts/start_demo_operator.sh",
    "demo:runtime:install": "bash scripts/install_pilot_demo_runtime.sh",
    "demo:runtime:stop": "bash scripts/stop_pilot_demo_runtime.sh",
    "demo:runtime:reset": "bash scripts/reset_pilot_demo_runtime.sh",
    "pilot:profile": "bash scripts/create_pilot_candidate_profile.sh",
    "pilot:scaffold-onboarding": "bash scripts/pilot_scaffold_real_onboarding.sh",
    "pilot:validate-onboarding": "bash scripts/pilot_validate_onboarding.sh",
    "pilot:check-launch-readiness": "bash scripts/pilot_check_launch_readiness.sh",
    "pilot:intake-from-onboarding": "bash scripts/pilot_onboarding_to_intake.sh",
    "pilot:prepare-from-onboarding": "bash scripts/pilot_prepare_from_onboarding.sh",
    "pilot:launch-from-onboarding": "bash scripts/pilot_launch_from_onboarding.sh",
    "pilot:profile-from-intake": "bash scripts/pilot_candidate_profile_from_intake.sh",
    "pilot:prepare-from-intake": "bash scripts/pilot_prepare_from_intake.sh",
    "pilot:readiness": "bash scripts/pilot_real_candidate_readiness.sh",
    "pilot:sandbox": "bash scripts/pilot_sandbox_refresh.sh",
    "pilot:test-tenant": "bash scripts/pilot_test_tenant_setup.sh",
    "pilot:inspect": "bash scripts/inspect_pilot_candidate_profile.sh",
    "pilot:profiles": "bash scripts/list_pilot_candidate_profiles.sh",
    "pilot:rehearse": "bash scripts/pilot_rehearsal.sh",
    "pilot:handoff-packet": "bash scripts/pilot_candidate_handoff_packet.sh",
    "pilot:create-plan": "bash scripts/pilot_candidate_creation_plan.sh",
    "pilot:apply-sql": "bash scripts/pilot_apply_candidate_sql.sh",
    "pilot:post-create-verify": "bash scripts/pilot_post_creation_verify.sh",
    "pilot:packet": "bash scripts/pilot_launch_packet.sh",
    "pilot:share": "bash scripts/pilot_share_launch_packet.sh",
    "pilot:deliver": "bash scripts/pilot_deliver_launch_packet.sh",
    "pilot:simulator-state": "bash scripts/simulator_org_state.sh",
    "pilot:audit": "bash scripts/pilot_activation_audit.sh",
    "pilot:vps": "bash scripts/pilot_readiness_vps.sh",
    "qa:vps": "bash scripts/qa_vps.sh",
    "qa:admin": "bash scripts/admin_review_smoke.sh",
    "qa:mobile": "bash scripts/mobile_qa_preflight.sh",
    "lint": "echo \"Lint targets not wired yet\"",
    "test": "node --test packages/shared/src/*.test.js apps/mobile/*.test.js apps/app-api/src/*.test.js apps/admin-web/*.test.js apps/worker/src/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "pg": "^8.16.0",
    "svix": "^1.94.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
