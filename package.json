{
  "name": "club-content-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @club/app-api run dev",
    "dev:admin": "npm --workspace @club/admin-web run dev",
    "dev:worker": "npm --workspace @club/worker run dev",
    "dev:mobile": "npm --workspace @club/mobile run dev",
    "test:unit": "node --test packages/shared/test/submission-serialization.test.js apps/worker/test/policy.test.js apps/worker/test/audience-rewrites.test.js",
    "smoke:e2e": "node scripts/e2e_submission_smoke.mjs",
    "smoke:settings": "node scripts/e2e_settings_smoke.mjs",
    "smoke:e2e:review": "E2E_SELECTED_CHANNELS=x E2E_RAW_TEXT='E2E smoke review post\\nChannels: X\\nTags: smoke, review\\nInjury update for the team' node scripts/e2e_submission_smoke.mjs",
    "lint": "echo \"Lint targets not wired yet\"",
    "test": "echo \"Test targets not wired yet\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "pg": "^8.16.0",
    "svix": "^1.94.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
