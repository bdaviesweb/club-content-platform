FROM node:20-alpine AS build

WORKDIR /app

ARG EXPO_PUBLIC_API_BASE_URL=https://clubcontent-api.davmn.net
ARG EXPO_PUBLIC_CLUB_SLUG=demo-soccer-club
ARG EXPO_PUBLIC_TEAM_SLUG=u14-girls
ARG EXPO_PUBLIC_SUBMITTER_EMAIL=coach@demo-club.local
ARG EXPO_PUBLIC_REVIEWER_EMAIL=comms@demo-club.local
ARG EXPO_PUBLIC_APP_NAME="Club Content"
ARG EXPO_PUBLIC_APP_SLUG=club-content
ARG EXPO_PUBLIC_APP_VERSION=0.1.0
ARG EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.hermes.clubcontent
ARG EXPO_PUBLIC_ANDROID_PACKAGE=com.hermes.clubcontent
ARG EXPO_PUBLIC_EXPO_OWNER=clubcontent
ARG EXPO_PUBLIC_WORKSPACE_MODE=poster

ENV EXPO_PUBLIC_API_BASE_URL=$EXPO_PUBLIC_API_BASE_URL
ENV EXPO_PUBLIC_CLUB_SLUG=$EXPO_PUBLIC_CLUB_SLUG
ENV EXPO_PUBLIC_TEAM_SLUG=$EXPO_PUBLIC_TEAM_SLUG
ENV EXPO_PUBLIC_SUBMITTER_EMAIL=$EXPO_PUBLIC_SUBMITTER_EMAIL
ENV EXPO_PUBLIC_REVIEWER_EMAIL=$EXPO_PUBLIC_REVIEWER_EMAIL
ENV EXPO_PUBLIC_APP_NAME=$EXPO_PUBLIC_APP_NAME
ENV EXPO_PUBLIC_APP_SLUG=$EXPO_PUBLIC_APP_SLUG
ENV EXPO_PUBLIC_APP_VERSION=$EXPO_PUBLIC_APP_VERSION
ENV EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=$EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER
ENV EXPO_PUBLIC_ANDROID_PACKAGE=$EXPO_PUBLIC_ANDROID_PACKAGE
ENV EXPO_PUBLIC_EXPO_OWNER=$EXPO_PUBLIC_EXPO_OWNER
ENV EXPO_PUBLIC_WORKSPACE_MODE=$EXPO_PUBLIC_WORKSPACE_MODE

COPY package.json package-lock.json ./
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN npm install

COPY apps/mobile ./apps/mobile
COPY packages/shared/src ./packages/shared/src

WORKDIR /app/apps/mobile
RUN npx expo export --platform web --output-dir dist

FROM node:20-alpine AS runtime

WORKDIR /app
ENV PORT=3000

COPY --from=build /app/apps/mobile/dist ./dist
COPY apps/mobile/web-server.js ./web-server.js

EXPOSE 3000
CMD ["node", "web-server.js"]
