{
  "name": "@club/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test pushRegistration.test.js rolePolicy.test.js",
    "doctor": "npx expo-doctor",
    "export:ios": "npx expo export --platform ios --clear",
    "testflight:build": "npx -y eas-cli@latest build --platform ios --profile production",
    "testflight:submit": "npx -y eas-cli@latest submit --platform ios --profile production"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  }
}
