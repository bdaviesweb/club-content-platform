{
  "name": "@club/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --port 8081 --clear",
    "android": "expo run:android",
    "ios": "node ./scripts/sim-guard.js check && expo run:ios --port 8081",
    "ios:local": "EXPO_LOCAL_BUILD=1 EXPO_NO_UPDATES=1 node ./scripts/sim-guard.js check && expo run:ios --configuration Release --no-bundler",
    "ios:device": "expo run:ios --device --port 8081",
    "ios:metro": "EXPO_USE_METRO=1 node ./scripts/sim-guard.js check && expo run:ios --port 8081",
    "ios:simulator": "node ./scripts/sim-guard.js check && expo run:ios --port 8081",
    "sim:check": "node ./scripts/sim-guard.js check",
    "sim:list": "node ./scripts/sim-guard.js list",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.2"
  }
}
